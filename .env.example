# ── POSTECH SES 로그인 ──────────────────────────────
SES_ID=your_student_id
SES_PW=your_password
# group: 1=학생 2=실습기관 3=학사담당자 4=지원센터
SES_GROUP=1

# ── Gmail 발신 계정 (알림 메일을 보내는 주소) ──────────
# 앱 비밀번호 발급: Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호
GMAIL_ADDRESS=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# 서버(run.py)가 켜질 때마다 "알림 시스템 시작" 메일을 보낼지 (true/false).
STARTUP_MAIL=false

# POSTECH 전자게시판 "인턴 및 채용 공고" 새 글 알림 (SES_ID/SES_PW 로 로그인).
# 받을 사람은 관리자 화면에서 수신자별로 켜고 끕니다. 게시판 점검 자체를 끄려면 false.
BOARD_ENABLED=true

# ── 점검 주기 ───────────────────────────────────────
# run.py 를 실행하면 이 주기(분)로 계속 반복 점검한다.
CHECK_INTERVAL_MINUTES=10
# 상세 페이지는 목록이 그대로여도 이 주기(시간)마다 다시 받는다.
DETAIL_REFRESH_HOURS=6

# ── 웹 서버 ─────────────────────────────────────────
# 기본은 이 컴퓨터에서만 접속(127.0.0.1). 다른 기기에서 열려면 0.0.0.0
HOST=127.0.0.1
PORT=7007
# 외부에서 접속하는 주소. 알림 메일에 "공고 모아보기" 링크로 들어간다 (비우면 생략).
BASE_URL=

# ── 관리자 로그인 (웹의 /admin 에서 메일 수신자 관리) ───
ADMIN_ID=admin
ADMIN_PASSWORD=change-me
# 세션 서명 키. 비우면 관리자 계정에서 자동으로 만든다.
SESSION_SECRET=

# MongoDB (공고 보관함·수신자·알림 기록)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_DB=admin
MONGO_DB=pocareers
